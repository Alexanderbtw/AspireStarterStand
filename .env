# Parameter parameterName
PARAMETERNAME=

# Parameter secretParameterName
SECRETPARAMETERNAME=

# Parameter mssql
MSSQL=

# Container image name for webfrontend
WEBFRONTEND_IMAGE=webfrontend:latest

# Container image name for reactfrontend
REACTFRONTEND_IMAGE=reactfrontend:latest

